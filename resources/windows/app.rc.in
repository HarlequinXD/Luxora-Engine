/* Generated by CMake from resources/windows/app.rc.in - do not edit. */
#include <winver.h>
#include <winnt.h>
/* fixed language so the editor can replace these resources in prebuilt players (UpdateResource) */
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/* Icon 1 is the application icon: Explorer, the taskbar and the window title bar use it. */
1 ICON "@LX_RC_ICON@"

#ifdef LX_EMBED_MANIFEST
1 24 "@LX_RC_MANIFEST@"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @LX_RC_V1@,@LX_RC_V2@,@LX_RC_V3@,0
 PRODUCTVERSION @LX_RC_V1@,@LX_RC_V2@,@LX_RC_V3@,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "@LX_RC_COMPANY@"
      VALUE "FileDescription",  "@LX_RC_DESC@"
      VALUE "FileVersion",      "@LX_RC_VERSION@"
      VALUE "InternalName",     "@LX_RC_EXE@"
      VALUE "LegalCopyright",   "Copyright (C) @LX_RC_COMPANY@"
      VALUE "OriginalFilename", "@LX_RC_EXE@.exe"
      VALUE "ProductName",      "@LX_RC_NAME@"
      VALUE "ProductVersion",   "@LX_RC_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
