#version 450
// GPU photon tracing: one photon per thread, traced through the static-geometry BVH exactly like the CPU
// tracer (src/gi/photon_gi.c). Deposits go into the cell they land in as fixed-point integers (atomicAdd
// on int works on every Vulkan GPU); gi_post.comp turns them back into floats, blends and blurs them.
layout(local_size_x = 64) in;

struct Node { vec4 a; vec4 b; };          // a: min xyz, first/left (int bits); b: max xyz, triangle count (int bits, 0 = inner)
struct Tri { vec4 v0; vec4 e1; vec4 e2; vec4 n; };   // v0.w = material index (int bits); in leaf order
layout(std430, set = 0, binding = 0) readonly buffer Nodes { Node nodes[]; };
layout(std430, set = 0, binding = 1) readonly buffer Tris { Tri tris[]; };
layout(std430, set = 0, binding = 2) readonly buffer Mats { vec4 albedo[]; };
layout(std430, set = 0, binding = 3) readonly buffer Emitters { vec4 em[]; };   // 3 per emitter
layout(std430, set = 0, binding = 4) buffer Deposits { int dep[]; };
layout(std430, set = 0, binding = 11) buffer Vis { float vis[]; };   // per cell: distance to the first surface +x -x +y -y +z -z (cells)
layout(std430, set = 0, binding = 15) readonly buffer Moving { vec4 mv[]; };   // moving objects' BVH this frame: nodes, then triangles
layout(set = 0, binding = 13, rgba8) uniform writeonly image3D vis_a;   // the same for shading: (+x -x +y -y) / 1.5
layout(set = 0, binding = 14, rgba8) uniform writeonly image3D vis_b;   //   (+z -z) / 1.5

layout(push_constant) uniform PC {
    vec4 origin_cell;    // grid origin, cell size
    ivec4 res_photons;   // grid resolution, photons this frame
    vec4 bmin_seed;      // scene bounds min, seed (uint bits)
    vec4 bext_power;     // scene bounds extent, total emitted power
    vec4 scales;         // flux per photon, deposit fixed-point scale (x 1/cell area), max bounces, emitter count
    ivec4 misc;          // x: this frame's first emitter vec4 (emitters are double-buffered per frame in flight)
                         // y: 0 trace photons, 1 find each cell's walls; z: sun step-back distance (float bits); w: texture z offset
    ivec4 misc2;         // moving objects: x first node vec4, y node count (0 = none), z first triangle vec4
} pc;

const float PI = 3.14159265;
uint rng;
float rnd() {
    rng = rng * 747796405u + 2891336453u;
    uint w = ((rng >> ((rng >> 28u) + 4u)) ^ rng) * 277803737u;
    return float(((w >> 22u) ^ w) >> 8) * (1.0 / 16777216.0);
}
vec3 rnd_sphere() {
    float z = 1.0 - 2.0 * rnd(), a = 2.0 * PI * rnd(), s = sqrt(max(0.0, 1.0 - z * z));
    return vec3(s * cos(a), s * sin(a), z);
}
vec3 rnd_cosine(vec3 n) {
    float u1 = rnd(), u2 = rnd();
    float r = sqrt(u1), phi = 2.0 * PI * u2;
    vec3 t = abs(n.x) > 0.9 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 b1 = normalize(cross(t, n)), b2 = cross(n, b1);
    return b1 * (r * cos(phi)) + b2 * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1));
}

float ray_box(vec3 bmin, vec3 bmax, vec3 o, vec3 inv, float tmax) {
    vec3 t1 = (bmin - o) * inv, t2 = (bmax - o) * inv;
    vec3 lo = min(t1, t2), hi = max(t1, t2);
    float tn = max(max(lo.x, lo.y), lo.z), tf = min(min(hi.x, hi.y), hi.z);
    return (tf >= tn && tn < tmax && tf > 0.0) ? tn : 1e30;
}

// closest hit: returns the triangle (or -1) and its distance
int trace(vec3 o, vec3 d, float tmax, out float best) {
    best = tmax;
    int hit = -1;
    vec3 inv = 1.0 / mix(d, vec3(1e-9), lessThan(abs(d), vec3(1e-9)));
    if (ray_box(nodes[0].a.xyz, nodes[0].b.xyz, o, inv, best) >= 1e30) return -1;
    int stack[48];
    int sp = 0, node = 0;
    for (int guard = 0; guard < 4096; guard++) {
        Node n = nodes[node];
        int count = floatBitsToInt(n.b.w), first = floatBitsToInt(n.a.w);
        if (count > 0) {
            for (int i = 0; i < count; i++) {
                Tri t = tris[first + i];
                vec3 p = cross(d, t.e2.xyz);
                float det = dot(t.e1.xyz, p);
                if (abs(det) < 1e-12) continue;
                float id = 1.0 / det;
                vec3 tv = o - t.v0.xyz;
                float u = dot(tv, p) * id;
                if (u < 0.0 || u > 1.0) continue;
                vec3 q = cross(tv, t.e1.xyz);
                float v = dot(d, q) * id;
                if (v < 0.0 || u + v > 1.0) continue;
                float dist = dot(t.e2.xyz, q) * id;
                if (dist > 1e-4 && dist < best) { best = dist; hit = first + i; }
            }
            if (sp == 0) break;
            node = stack[--sp];
            continue;
        }
        int c1 = first, c2 = first + 1;
        float d1 = ray_box(nodes[c1].a.xyz, nodes[c1].b.xyz, o, inv, best);
        float d2 = ray_box(nodes[c2].a.xyz, nodes[c2].b.xyz, o, inv, best);
        if (d1 > d2) { float td = d1; d1 = d2; d2 = td; int ti = c1; c1 = c2; c2 = ti; }
        if (d1 >= 1e30) {
            if (sp == 0) break;
            node = stack[--sp];
        } else {
            node = c1;
            if (d2 < 1e30 && sp < 48) stack[sp++] = c2;
        }
    }
    return hit;
}

// can cell c see grid point g? (its walls along each axis, as the CPU's vis_sees)
bool sees(ivec3 c, vec3 g) {
    int i = ((c.z * pc.res_photons.y + c.y) * pc.res_photons.x + c.x) * 6;
    vec3 d = g - (vec3(c) + 0.5);
    for (int a = 0; a < 3; a++) {
        float wall = d[a] >= 0.0 ? vis[i + a * 2] : vis[i + a * 2 + 1];
        if (wall < abs(d[a]) - 0.02) return false;
    }
    return true;
}

// The deposit goes to one of the 8 cells around it, picked in proportion to its trilinear weight among the
// cells on the photon's side of any wall (the CPU spreads it over them; same result on average).
// the moving objects' BVH (their current triangles: skinned characters in their pose), as trace() for the level;
// triangles carry their bounce colour in the w of e1, e2, n
int trace_moving(vec3 o, vec3 d, float tmax, out float best) {
    best = tmax;
    if (pc.misc2.y == 0) return -1;
    int nb = pc.misc2.x, tb = pc.misc2.z;
    vec3 inv = 1.0 / mix(d, vec3(1e-9), lessThan(abs(d), vec3(1e-9)));
    if (ray_box(mv[nb].xyz, mv[nb + 1].xyz, o, inv, best) >= 1e30) return -1;
    int stack[48];
    int sp = 0, node = 0, hit = -1;
    for (int guard = 0; guard < 4096; guard++) {
        vec4 na = mv[nb + node * 2], nbx = mv[nb + node * 2 + 1];
        int count = floatBitsToInt(nbx.w), first = floatBitsToInt(na.w);
        if (count > 0) {
            for (int i = 0; i < count; i++) {
                int t = tb + (first + i) * 4;
                vec3 v0 = mv[t].xyz, e1 = mv[t + 1].xyz, e2 = mv[t + 2].xyz;
                vec3 p = cross(d, e2);
                float det = dot(e1, p);
                if (abs(det) < 1e-12) continue;
                float id = 1.0 / det;
                vec3 tv = o - v0;
                float u = dot(tv, p) * id;
                if (u < 0.0 || u > 1.0) continue;
                vec3 q = cross(tv, e1);
                float v = dot(d, q) * id;
                if (v < 0.0 || u + v > 1.0) continue;
                float dist = dot(e2, q) * id;
                if (dist > 1e-4 && dist < best) { best = dist; hit = t; }
            }
            if (sp == 0) break;
            node = stack[--sp];
            continue;
        }
        int c1 = first, c2 = first + 1;
        float d1 = ray_box(mv[nb + c1 * 2].xyz, mv[nb + c1 * 2 + 1].xyz, o, inv, best);
        float d2 = ray_box(mv[nb + c2 * 2].xyz, mv[nb + c2 * 2 + 1].xyz, o, inv, best);
        if (d1 > d2) { float td = d1; d1 = d2; d2 = td; int ti = c1; c1 = c2; c2 = ti; }
        if (d1 >= 1e30) {
            if (sp == 0) break;
            node = stack[--sp];
        } else {
            node = c1;
            if (d2 < 1e30 && sp < 48) stack[sp++] = c2;
        }
    }
    return hit;
}

void deposit(vec3 pos, vec3 dir, vec3 flux) {
    ivec3 res = pc.res_photons.xyz;
    vec3 g = (pos - pc.origin_cell.xyz) / pc.origin_cell.w;
    vec3 t = g - 0.5;
    ivec3 base = ivec3(floor(t));
    vec3 f = t - vec3(base);
    float w[8], plain[8];
    float sum = 0.0, psum = 0.0;
    for (int k = 0; k < 8; k++) {
        ivec3 o = ivec3(k & 1, (k >> 1) & 1, k >> 2);
        ivec3 c = base + o;
        vec3 ww = mix(1.0 - f, f, vec3(o));
        bool inside = all(greaterThanEqual(c, ivec3(0))) && all(lessThan(c, res));
        plain[k] = inside ? ww.x * ww.y * ww.z : 0.0;
        w[k] = (inside && sees(c, g)) ? plain[k] : 0.0;
        sum += w[k];
        psum += plain[k];
    }
    if (sum < 1e-6) { for (int k = 0; k < 8; k++) w[k] = plain[k]; sum = psum; }
    if (sum < 1e-6) return;
    float pick = rnd() * sum;
    int chosen = 7;
    for (int k = 0; k < 8; k++) { if (pick < w[k]) { chosen = k; break; } pick -= w[k]; }
    if (w[chosen] <= 0.0) return;
    ivec3 c = base + ivec3(chosen & 1, (chosen >> 1) & 1, chosen >> 2);
    int cbase = ((c.z * res.y + c.y) * res.x + c.x) * 12;
    vec3 wd = -dir;   // light arrives from where the photon came
    vec4 sh = vec4(0.282095, 0.488603 * wd.y, 0.488603 * wd.z, 0.488603 * wd.x);
    vec3 fl = flux * pc.scales.y;
    // random rounding: unbiased, so even deposits smaller than one unit add up to the right total
    for (int k = 0; k < 4; k++) {
        int ir = int(floor(fl.r * sh[k] + rnd())), ig = int(floor(fl.g * sh[k] + rnd())), ib = int(floor(fl.b * sh[k] + rnd()));
        if (ir != 0) atomicAdd(dep[cbase + k], ir);
        if (ig != 0) atomicAdd(dep[cbase + 4 + k], ig);
        if (ib != 0) atomicAdd(dep[cbase + 8 + k], ib);
    }
}

// walls mode: six short rays from each cell's centre (the CPU does this for the scene grid in photon_gi.c)
void find_walls(int i) {
    ivec3 r = pc.res_photons.xyz;
    if (i >= r.x * r.y * r.z) return;
    ivec3 c = ivec3(i % r.x, (i / r.x) % r.y, i / (r.x * r.y));
    float cell = pc.origin_cell.w;
    vec3 o = pc.origin_cell.xyz + (vec3(c) + 0.5) * cell;
    const vec3 dirs[6] = vec3[6](vec3(1, 0, 0), vec3(-1, 0, 0), vec3(0, 1, 0), vec3(0, -1, 0), vec3(0, 0, 1), vec3(0, 0, -1));
    float v[6];
    for (int k = 0; k < 6; k++) {
        float t;
        v[k] = trace(o, dirs[k], 1.5 * cell, t) >= 0 ? t / cell : 1.5;
        vis[i * 6 + k] = v[k];
    }
    ivec3 at = c + ivec3(0, 0, pc.misc.w);
    imageStore(vis_a, at, vec4(v[0], v[1], v[2], v[3]) / 1.5);
    imageStore(vis_b, at, vec4(v[4], v[5], 1.0, 1.0) / vec4(1.5, 1.5, 1.0, 1.0));
}

// Bounced (and sky) light fills the air it travels through: two random points along each stretch of a photon's
// path (clipped to this grid) carry its light, flux x (length / 2) / cell each, as photon_gi.c's push_path.
void deposit_path(vec3 o, vec3 d, float t_hit, vec3 flux) {
    vec3 lo = pc.origin_cell.xyz, hi = lo + vec3(pc.res_photons.xyz) * pc.origin_cell.w;
    float tn = 0.0, tf = t_hit;
    for (int a = 0; a < 3; a++) {
        if (abs(d[a]) < 1e-9) { if (o[a] < lo[a] || o[a] > hi[a]) return; continue; }
        float a1 = (lo[a] - o[a]) / d[a], a2 = (hi[a] - o[a]) / d[a];
        tn = max(tn, min(a1, a2));
        tf = min(tf, max(a1, a2));
    }
    if (tf <= tn) return;
    float w = (tf - tn) / (2.0 * pc.origin_cell.w);
    for (int k = 0; k < 2; k++) deposit(o + d * (tn + (tf - tn) * rnd()), d, flux * w);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (pc.misc.y == 1) { find_walls(int(id)); return; }
    if (id >= uint(pc.res_photons.w)) return;
    rng = id * 1664525u + floatBitsToUint(pc.bmin_seed.w);
    rnd(); rnd();
    // choose an emitter in proportion to its power
    int count = int(pc.scales.w);
    float pick = rnd() * pc.bext_power.w;
    int e = count - 1;
    for (int k = 0; k < count; k++)
        if (pick < em[pc.misc.x + k * 3 + 2].w) { e = k; break; }
    int eb = pc.misc.x + e * 3;
    vec4 e0 = em[eb], e1 = em[eb + 1], e2 = em[eb + 2];
    int kind = int(e0.w + 0.5);
    vec3 bmin = pc.bmin_seed.xyz, ext = pc.bext_power.xyz;
    vec3 o, d;
    if (kind == 0) {          // directional: a random point in the scene, stepped back against the light
        vec3 p = bmin + vec3(rnd(), rnd(), rnd()) * ext;
        d = e1.xyz;
        o = p - d * intBitsToFloat(pc.misc.z);
    } else if (kind == 1) {   // point
        o = e0.xyz;
        d = rnd_sphere();
    } else if (kind == 2) {   // spot: uniform in the cone
        float z = 1.0 - rnd() * (1.0 - e1.w);
        float a = rnd() * 2.0 * PI, r = sqrt(max(0.0, 1.0 - z * z));
        vec3 t = abs(e1.y) < 0.9 ? vec3(0, 1, 0) : vec3(1, 0, 0);
        vec3 bx = normalize(cross(t, e1.xyz)), by = cross(e1.xyz, bx);
        o = e0.xyz;
        d = bx * (r * cos(a)) + by * (r * sin(a)) + e1.xyz * z;
    } else {                  // sky: a plane over the scene shining down
        o = vec3(bmin.x + rnd() * ext.x, bmin.y + ext.y, bmin.z + rnd() * ext.z);
        d = rnd_cosine(vec3(0, -1, 0));
    }
    vec3 flux = e2.xyz * pc.scales.x;
    bool sky = kind == 3;
    int bounces = int(pc.scales.z);
    for (int b = 0; b <= bounces; b++) {
        float t;
        int tri = trace(o, d, 1e30, t);
        vec3 n = vec3(0, 1, 0), alb = vec3(0.0);
        if (tri >= 0) { n = tris[tri].n.xyz; alb = albedo[floatBitsToInt(tris[tri].v0.w)].xyz; }
        bool got = tri >= 0;
        float tm;
        int mt = trace_moving(o, d, t, tm);   // moving objects, closer than the level?
        if (mt >= 0) { t = tm; n = mv[mt + 3].xyz; alb = vec3(mv[mt + 1].w, mv[mt + 2].w, mv[mt + 3].w); got = true; }
        if (b > 0 || sky) deposit_path(o, d, got ? t : 1e30, flux);   // bounced light fills the air
        if (!got) break;
        vec3 pos = o + d * t;
        if (dot(n, d) > 0.0) n = -n;
        float survive = clamp(max(alb.x, max(alb.y, alb.z)), 0.0, 0.95);
        if (rnd() >= survive) break;
        flux = flux * alb / survive;
        o = pos + n * 1e-3;
        d = rnd_cosine(n);
    }
}
