# Writes a C file embedding the script SDK (headers + compiler runtime) as byte arrays.
# Inputs: OUT, ROOT. Run at configure time from CMakeLists.txt.
set(entries
  "include/stddef.h=third_party/tinycc/include/stddef.h"
  "include/stdarg.h=third_party/tinycc/include/stdarg.h"
  "include/stdbool.h=third_party/tinycc/include/stdbool.h"
  "include/float.h=third_party/tinycc/include/float.h"
  "include/stdalign.h=third_party/tinycc/include/stdalign.h"
  "include/stdnoreturn.h=third_party/tinycc/include/stdnoreturn.h"
  "include/luxora/luxora.h=include/luxora/luxora.h"
  "include/luxora/lx_math.h=include/luxora/lx_math.h"
  "lib/libtcc1.c=third_party/tinycc/lib/libtcc1.c"
  "lib/va_list.c=third_party/tinycc/lib/va_list.c"
  "lib/alloca.S=third_party/tinycc/lib/alloca.S"
  "lib/chkstk.S=third_party/tinycc/lib/chkstk.S"
  "lib/lib-arm64.c=third_party/tinycc/lib/lib-arm64.c")
file(GLOB shims RELATIVE "${ROOT}/resources/script_sdk/include" "${ROOT}/resources/script_sdk/include/*.h")
foreach(s ${shims})
  list(APPEND entries "include/${s}=resources/script_sdk/include/${s}")
endforeach()
set(body "/* generated by tools/embed_sdk.cmake */\n")
set(table "")
set(i 0)
foreach(e ${entries})
  string(REPLACE "=" ";" kv "${e}")
  list(GET kv 0 name)
  list(GET kv 1 src)
  file(READ "${ROOT}/${src}" hex HEX)
  string(LENGTH "${hex}" len)
  math(EXPR size "${len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
  string(APPEND body "static const unsigned char f${i}[] = {\n${bytes}0};\n")
  string(APPEND table "    {\"${name}\", f${i}, ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "typedef struct LxSdkFile { const char *path; const unsigned char *data; unsigned size; } LxSdkFile;\n")
string(APPEND body "const LxSdkFile lx_sdk_files[] = {\n${table}};\nconst int lx_sdk_file_count = ${i};\n")
file(WRITE "${OUT}.tmp" "${body}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
