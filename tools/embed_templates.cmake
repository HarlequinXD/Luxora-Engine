# Writes a C file embedding the game template files (resources/templates/<template>/...) as text.
# Inputs: OUT, ROOT. Run from CMakeLists.txt whenever a template file changes.
file(GLOB_RECURSE files RELATIVE "${ROOT}/resources/templates" "${ROOT}/resources/templates/*")
list(SORT files)
set(body "/* generated by tools/embed_templates.cmake */\n")
set(table "")
set(i 0)
foreach(f ${files})
  file(READ "${ROOT}/resources/templates/${f}" hex HEX)
  string(LENGTH "${hex}" len)
  math(EXPR size "${len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
  string(APPEND body "static const unsigned char t${i}[] = {\n${bytes}0};\n")
  string(APPEND table "    {\"${f}\", t${i}, ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "typedef struct LxTemplateFile { const char *path; const unsigned char *data; unsigned size; } LxTemplateFile;\n")
string(APPEND body "const LxTemplateFile lx_template_files[] = {\n${table}    {0, 0, 0}};\nconst int lx_template_file_count = ${i};\n")
file(WRITE "${OUT}.tmp" "${body}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
